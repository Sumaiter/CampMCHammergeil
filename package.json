{
  "name": "campmchammergeil",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply campmchammergeil --local",
    "db:migrate:remote": "wrangler d1 migrations apply campmchammergeil --remote",
    "create-admin": "node scripts/create-admin.ts",
    "reset-shop-data": "node scripts/reset-shop-data.ts"
  },
  "dependencies": {
    "@fontsource/metal-mania": "^5.3.0",
    "hono": "^4.13.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "vue": "^3.5.32",
    "vue-powerglitch": "^1.1.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "~4.1.11",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
